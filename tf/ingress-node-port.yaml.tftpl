# AUTO-GENERATED from Terraform. Do not edit manually.
apiVersion: v1
kind: Service
metadata:
  name: ingress-nginx-controller
spec:
  type: NodePort
  selector:
    app: api
  ports:
    - port: 80
      targetPort: 80
      nodePort: ${vol.http_port}
    - port: 443
      targetPort: 443
      # Every Node in cluster exposes service through this port
      nodePort: ${vol.https_port}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: main-ad${vol.index + 1}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: ${vol.size_gb}Gi
  storageClassName: oci-bv
  volumeMode: Filesystem
  volumeName: main-ad${vol.index + 1}
%{ endfor ~}
