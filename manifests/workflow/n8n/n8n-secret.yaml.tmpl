apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: default
type: Opaque
stringData:
  # Used for credentials at rest. Generate once and keep stable across reinstalls:
  #   openssl rand -hex 32
  encryption-key: ${N8N_ENCRYPTION_KEY}
  instance-owner-email: ${N8N_INSTANCE_OWNER_EMAIL}
  instance-owner-first-name: ${N8N_INSTANCE_OWNER_FIRST_NAME}
  instance-owner-last-name: ${N8N_INSTANCE_OWNER_LAST_NAME}
  instance-owner-password-hash: ${N8N_INSTANCE_OWNER_PASSWORD_HASH}
